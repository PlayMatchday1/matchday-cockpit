#!/bin/sh
# PRE-PUSH: TYPECHECK AND THE SECOND-SCALE GUARDS. NOTHING ELSE.
#
# THE POLICY CHANGED ON 2026-08-25, and this file is most of what it means.
#
# There is NO browser lane and NO E2E on any push. The gate used to route a diff to a twenty-minute
# Playwright run; that run blocked six pushes in one day, and every single block was the lane rather
# than the change — a suite that dated, a suite that timed out under contention, a suite testing a
# working tree that was being edited while it ran. Twenty minutes to learn nothing is not a gate,
# it is a tax.
#
# WHAT RUNS: `npm run verify` — typecheck plus the node suites, about twenty seconds.
#
# WHY THOSE STAY. They are not a general test suite; they are the guards on the things that reach a
# player — the stage deny-list, the production host guard, the wall-clock trap, the change-log hook,
# the credits and roster and promo write models. That is exactly the carve-out the policy keeps:
# checkout, bookings, payments, credits, and anything that changes what a match record says
# happened. Twenty seconds, not twenty minutes.
#
# EVERYTHING ELSE — admin UI, reports, filters, layout, copy, read-only pages — is typecheck, look
# at it in a browser, push. No new assertions. See "The bar" in CLAUDE.md.
#
# The browser suites still EXIST and still run on demand (`npm run verify:e2e`, or one file
# directly) for the rare change where driving the page is genuinely the fastest way to see it. They
# are a tool now, not a toll.
#
# `git push --no-verify` still bypasses this.
set -e

echo "▶ pre-push: npm run verify (typecheck + node guards, ~20s) …"
npm run verify
echo "✓ pre-push: passed"

# THE PRODUCTION BUILD RUNS AFTER THE PUSH, NOT BEFORE IT. seam-artifact-check builds an isolated
# production bundle and greps it for the realtime test seam — ~100s, detached, so the push never
# waits on it. The STRUCTURAL half (seam-stripped-test) runs inline in milliseconds, and Vercel
# builds the same commit and fails the deploy on the same error. Skip with SEAM_ARTIFACT_SKIP=1.
if [ "${SEAM_ARTIFACT_SKIP:-0}" != "1" ]; then
  rm -f .seam-artifact-result
  nohup npm run --silent verify:seam-artifact > /tmp/seam-artifact.log 2>&1 &
  echo "▶ post-push: seam artifact check running in the background (~100s)"
  echo "    verdict → .seam-artifact-result · log → /tmp/seam-artifact.log"
fi
